+async fn ensure_absent<S: Storage + ?Sized>(storage: &S, path: &str) -> Result<()> {
+    if storage.exists(path).await? {
+        return Err(crate::Error::new(
+            crate::ErrorKind::PreconditionFailed,
+            format!("refusing to overwrite existing file {path}"),
+        ));
+    }
+    Ok(())
+}
