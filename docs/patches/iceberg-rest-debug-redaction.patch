+impl std::fmt::Debug for RestCatalogConfig {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let props: std::collections::BTreeMap<_, _> =
+            self.props.keys().map(|key| (key, "<redacted>")).collect();
