+    #[tokio::test]
+    async fn test_positional_deletes_are_scoped_to_scan_task() {
+        let tmp_dir = TempDir::new().unwrap();
+        let tasks = setup(tmp_dir.path());
+        let old_path = tasks[0].data_file_path();
+        let new_path = tasks[1].data_file_path();
+
+        // An older shared delete names both data files, but the second data
+        // file was added at a higher sequence. Its task excludes this delete.
+        let batch = RecordBatch::try_new(create_pos_del_schema(), vec![
+            Arc::new(StringArray::from(vec![old_path, new_path])),
+            Arc::new(Int64Array::from(vec![2, 7])),
+        ])
+        .unwrap();
+        let shared_path = tmp_dir.path().join("shared.parquet");
+        let mut writer =
+            ArrowWriter::try_new(File::create(&shared_path).unwrap(), batch.schema(), None)
+                .unwrap();
+        writer.write(&batch).unwrap();
+        writer.close().unwrap();
+        let shared = FileScanTaskDeleteFile::builder()
+            .with_file_path(shared_path.to_str().unwrap().to_owned())
+            .with_file_size_in_bytes(std::fs::metadata(&shared_path).unwrap().len())
+            .with_file_type(DataContentType::PositionDeletes)
+            .with_file_format(DataFileFormat::Parquet)
+            .with_partition_spec_id(0)
+            .build();
+        let older_task = FileScanTask::builder()
+            .with_file_size_in_bytes(0)
+            .with_start(0)
+            .with_length(0)
+            .with_data_file_path(old_path.to_owned())
+            .with_data_file_format(DataFileFormat::Parquet)
+            .with_schema(tasks[0].schema_ref())
+            .with_project_field_ids(vec![])
+            .with_deletes(vec![shared])
+            .with_case_sensitive(false)
+            .build()
+            .unwrap();
+        let tasks = [older_task, tasks[1].clone()];
+        let expected = [vec![2], vec![0, 1, 3, 5, 6, 8, 1022, 1023]];
+
+        // Both orders matter: loading another task must neither contaminate
+        // a future lookup nor mutate a vector already handed to a reader.
+        for order in [[0, 1], [1, 0]] {
+            let loader =
+                CachingDeleteFileLoader::new(FileIO::new_with_fs(), 10, Runtime::current());
+            let mut vectors = Vec::new();
+            for i in order {
+                let task = &tasks[i];
+                let filter = loader
+                    .load_deletes(task.deletes(), task.schema_ref())
+                    .await
+                    .unwrap()
+                    .unwrap();
+                vectors.push((i, filter.get_delete_vector(task).unwrap()));
+            }
+            for (i, vector) in vectors {
+                assert_eq!(
+                    vector.lock().unwrap().iter().collect::<Vec<_>>(),
+                    expected[i],
+                    "delete positions must depend only on this task's inputs"
+                );
+            }
+        }
     }
 
