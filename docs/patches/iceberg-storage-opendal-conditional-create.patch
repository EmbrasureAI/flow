+
+    async fn writer_if_absent(&self, path: &str) -> Result<Box<dyn FileWrite>> {
+        self.resolve(path)?.writer_if_absent(path).await
+    }
+
     async fn delete(&self, path: &str) -> Result<()> {
         self.resolve(path)?.delete(path).await
     }
