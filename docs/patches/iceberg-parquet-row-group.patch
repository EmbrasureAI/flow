 impl ParquetWriter {
+    /// Flush the current row group without closing the file.
+    ///
+    /// Callers can enforce logical input byte limits before appending another
+    /// batch, independently of Parquet's estimated encoded-size threshold.
+    pub async fn flush_row_group(&mut self) -> Result<()> {
+        if let Some(writer) = &mut self.inner_writer {
+            writer.flush().await.map_err(|err| {
+                Error::new(ErrorKind::Unexpected, "Failed to flush parquet row group.")
+                    .with_source(err)
+            })?;
+        }
+        Ok(())
+    }
